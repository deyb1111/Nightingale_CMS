# ============================================================
# NIGHTINGALE CMS — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to source control.
# ============================================================

APP_NAME="Nightingale"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/nightingale_cms/public
# 32-byte random string. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ── Database ─────────────────────────────────────────────────
# The application MUST use cms_app_user (least privilege).
# cms_readonly is only for ad-hoc admin reporting queries.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nightingale_cms
DB_USER=cms_app_user
DB_PASSWORD=Cms@AppUser2026!

# ── Session ──────────────────────────────────────────────────
SESSION_NAME=NIGHTINGALE_SID
# 8 hours per Reference §03 #16
SESSION_LIFETIME_SECONDS=28800
# Set to 1 in production (HTTPS only).
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# ── Email (PHPMailer over SMTP) ──────────────────────────────
# For Gmail: create an App Password at
# https://myaccount.google.com/apppasswords
# (requires 2FA already enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM=no-reply@nightingale.clinic
SMTP_FROM_NAME="Nightingale Clinic"
# When true, emails are written to storage/mail.log instead of being sent.
# Useful for local development without a real SMTP account.
MAIL_LOG_ONLY=true

# ── Admin notifications ──────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL=admin@nightingale.clinic

# ── Security ─────────────────────────────────────────────────
# Restricts access to admin-login.php to the listed IPs.
# Comma-separated. Leave empty to allow any IP (development only).
ADMIN_IP_ALLOWLIST=

# Issuer label shown in Google Authenticator / Authy.
TOTP_ISSUER="Nightingale CMS"
